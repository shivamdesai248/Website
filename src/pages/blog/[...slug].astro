---
/**
 * All blog routes: /blog and /blog/<post>.
 * When features.blog is false, getStaticPaths returns nothing, so no blog page exists.
 * (Flag-driven paths also work live in the dev server — no restart needed.)
 */
import type { CollectionEntry } from 'astro:content';
import { site } from '../../../site.config';
import { getPosts } from '../../lib/content';
import BlogIndex from '../../components/pages/BlogIndex.astro';
import BlogPost from '../../components/pages/BlogPost.astro';

export async function getStaticPaths() {
  if (!site.features.blog) return [];
  const posts = await getPosts();
  return [
    { params: { slug: undefined }, props: {} },
    ...posts.map((post, i) => ({
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
    })),
  ];
}

interface Props {
  post?: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post, newer, older } = Astro.props;
---
{post ? <BlogPost post={post} newer={newer} older={older} /> : <BlogIndex />}
