---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Clickable card: image well + label + title + summary + tags + lime arrow badge. See docs/DESIGN.md §5. */
interface Props {
  href: string;
  label: string;
  title: string;
  summary: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  coverFit?: 'cover' | 'contain';
  /** Shown in the image well when there is no cover image. */
  word?: string;
  sizes?: string;
}
const {
  href,
  label,
  title,
  summary,
  tags = [],
  cover,
  coverAlt = '',
  coverFit = 'cover',
  word = '',
  sizes = '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw',
} = Astro.props;
---
<a href={href} class="xcard">
  <div class:list={['media', `media-${coverFit}`, { 'media-empty': !cover }]}>
    {
      cover ? (
        <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes={sizes} />
      ) : (
        <span class="wordmark media-word" aria-hidden="true">{word}</span>
      )
    }
  </div>
  <div class="body">
    <p class="label meta">{label}</p>
    <h3 class="title">{title}</h3>
    <p class="summary">{summary}</p>
    <div class="foot">
      <div class="tags">{tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</div>
      <span class="arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 11 11 5M6 5h5v5" /></svg>
      </span>
    </div>
  </div>
</a>
<style>
  .xcard {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .xcard:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: radial-gradient(ellipse at 50% 60%, var(--media-glow), transparent 70%), var(--surface-2);
    overflow: hidden;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  /* Renders on a transparent background: shown whole, with room around them. */
  .media-contain :global(img) {
    object-fit: contain;
    padding: 9% 12%;
  }
  .xcard:hover .media :global(img) {
    transform: scale(1.03);
  }
  .media-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .media-word {
    font-size: clamp(36px, 5vw, 64px);
    color: var(--fg);
    opacity: 0.9;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 22px 20px;
    flex: 1;
  }
  .meta {
    margin: 0;
  }
  .title {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .foot {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--on-accent);
  }
  .arrow svg {
    width: 14px;
    height: 14px;
  }
</style>
