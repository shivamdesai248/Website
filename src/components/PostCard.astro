---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { formatDate, readingTime } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const d = post.data;
---
<a href={url(`/blog/${post.id}`)} class="pcard">
  {d.cover && <div class="media"><Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" /></div>}
  <p class="label meta">{formatDate(d.date)} · {readingTime(post.body)}</p>
  <h3 class="title">{d.title}</h3>
  <p class="desc">{d.description}</p>
</a>
<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .media {
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    margin-bottom: 6px;
    background: var(--surface);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .pcard:hover .media :global(img) {
    transform: scale(1.03);
  }
  .meta {
    margin: 0;
  }
  .title {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .pcard:hover .title {
    color: var(--accent-ink);
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 15.5px;
  }
</style>
