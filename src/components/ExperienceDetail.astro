---
/**
 * Layout for a single experience write-up (an experience page or one of its tracks,
 * e.g. /experience/soar/embedded). The Markdown body goes in the default slot.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import PhotoTitle from './PhotoTitle.astro';
import Gallery from './Gallery.astro';
import Documents, { type DocItem } from './Documents.astro';

interface Props {
  backHref: string;
  backText: string;
  meta: string;
  title: string;
  summary: string;
  role?: string;
  tags?: string[];
  stats?: { value: string; label: string }[];
  cover?: ImageMetadata;
  coverAlt?: string;
  coverFit?: 'cover' | 'contain';
  gallery?: { image: ImageMetadata; alt: string; caption?: string }[];
  documents?: DocItem[];
  related?: CollectionEntry<'blog'>[];
  next?: { href: string; title: string; label?: string };
  /** Optional wide photo shown first, under the back link (e.g. a team photo). */
  heroPhoto?: ImageMetadata;
  heroAlt?: string;
  heroPosition?: string;
}
const {
  backHref,
  backText,
  meta,
  title,
  summary,
  role,
  tags = [],
  stats = [],
  cover,
  coverAlt = '',
  coverFit = 'cover',
  gallery = [],
  documents = [],
  related = [],
  next,
  heroPhoto,
  heroAlt = '',
  heroPosition = '50% 50%',
} = Astro.props;
---
<Base title={title} description={summary}>
  <article>
    <header class="container head">
      <a href={backHref} class="link-arrow back"><span aria-hidden="true">←</span> {backText}</a>
      {
        heroPhoto ? (
          <PhotoTitle image={heroPhoto} alt={heroAlt} position={heroPosition} label={meta} title={title} />
        ) : (
          <>
            <p class="label meta">{meta}</p>
            <h1 class="h-display title">{title}</h1>
          </>
        )
      }
      <p class="summary">{summary}</p>
      {role && <p class="label role">{role}</p>}
    </header>

    {
      stats.length > 0 && (
        <div class="container">
          <dl class="stats" style={`--cols:${stats.length}`}>
            {stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      cover && (
        <div class="container">
          <div class:list={['cover', `cover-${coverFit}`]}>
            <Image src={cover} alt={coverAlt} widths={[640, 1200, 2000]} sizes="(max-width: 1360px) 100vw, 1360px" loading="eager" />
          </div>
        </div>
      )
    }

    <div class="container body">
      <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      gallery.length > 0 && <Gallery items={gallery} />
    }

    {
      documents.length > 0 && <Documents items={documents} />
    }

    {
      related.length > 0 && (
        <section class="container related">
          <p class="label">Related writing</p>
          <div class="rgrid">{related.map((p) => <PostCard post={p} />)}</div>
        </section>
      )
    }

    {
      next && (
        <nav class="container next" aria-label="Next">
          <a href={next.href}>
            <span class="label">{next.label ?? 'Next'}</span>
            <span class="next-title">{next.title} <span class="arr" aria-hidden="true">↗</span></span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: 36px;
  }
  .back {
    margin-bottom: clamp(32px, 6vw, 64px);
  }
  .back span {
    color: var(--accent-ink);
  }
  .meta {
    margin: 0 0 14px;
  }
  .title {
    margin: 0 0 18px;
    font-size: clamp(40px, 6.4vw, 92px);
    max-width: 16ch;
  }
  .head :global(.pt) {
    margin-bottom: 28px;
  }
  .summary {
    margin: 0 0 18px;
    max-width: 680px;
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--fg-2);
    line-height: 1.5;
  }
  .role {
    margin: 0;
    color: var(--fg-2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    margin: 0 0 36px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats div {
    padding: 22px 20px 22px 0;
  }
  .stats div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .stats dt {
    margin-bottom: 6px;
  }
  .stats dd {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 36px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent-ink);
  }
  @media (max-width: 700px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats div + div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  .cover {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: radial-gradient(ellipse at 50% 60%, var(--accent-soft), transparent 70%), var(--surface);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: cover;
  }
  .cover-contain :global(img) {
    object-fit: contain;
    height: min(70vh, 720px);
    padding: 24px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    padding-block: clamp(48px, 7vw, 96px);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: flex-start;
    position: sticky;
    top: var(--sticky-top);
    align-self: start;
  }
  .body .prose > :global(:first-child) {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .tags {
      position: static;
    }
  }

  .related {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .rgrid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }

  .next {
    border-top: 1px solid var(--line);
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: clamp(40px, 6vw, 80px);
    text-decoration: none;
  }
  .next-title {
    font-size: clamp(30px, 4.6vw, 64px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .arr {
    color: var(--accent-ink);
  }
  .next a:hover .next-title {
    color: var(--accent-ink);
  }
</style>
