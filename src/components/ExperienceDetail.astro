---
/**
 * Layout for a single experience write-up (an experience page or one of its tracks,
 * e.g. /experience/soar/embedded). The Markdown body goes in the default slot.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import PhotoTitle from './PhotoTitle.astro';
import Gallery, { type GalleryItem } from './Gallery.astro';
import Documents, { type DocItem } from './Documents.astro';

interface Props {
  backHref: string;
  backText: string;
  meta: string;
  title: string;
  summary: string;
  role?: string;
  tags?: string[];
  stats?: { value: string; label: string }[];
  cover?: ImageMetadata;
  coverAlt?: string;
  coverFit?: 'cover' | 'contain';
  gallery?: GalleryItem[];
  documents?: DocItem[];
  related?: CollectionEntry<'blog'>[];
  next?: { href: string; title: string; label?: string };
  /** Optional wide photo shown first, under the back link (e.g. a team photo). */
  heroPhoto?: ImageMetadata;
  heroAlt?: string;
  heroPosition?: string;
  /** Product shots side by side on a white panel above the title (instead of heroPhoto). */
  heroStrip?: { image: ImageMetadata; alt: string }[];
}
const {
  backHref,
  backText,
  meta,
  title,
  summary,
  role,
  tags = [],
  stats = [],
  cover,
  coverAlt = '',
  coverFit = 'cover',
  gallery = [],
  documents = [],
  related = [],
  next,
  heroPhoto,
  heroAlt = '',
  heroPosition = '50% 50%',
  heroStrip = [],
} = Astro.props;
---
<Base title={title} description={summary}>
  <article>
    <header class="container head">
      <a href={backHref} class="link-arrow back"><span aria-hidden="true">←</span> {backText}</a>
      {
        heroPhoto ? (
          <PhotoTitle image={heroPhoto} alt={heroAlt} position={heroPosition} label={meta} title={title} />
        ) : (
          <>
            {heroStrip.length > 0 ? (
              <div class="spt">
                <div class="strip" style={`--n:${heroStrip.length}`}>
                  {heroStrip.map((s) => (
                    <Image src={s.image} alt={s.alt} widths={[320, 640, Math.min(1000, s.image.width)]} sizes="(max-width: 760px) 33vw, 30vw" loading="eager" />
                  ))}
                </div>
                <div class="spt-text">
                  <p class="label meta">{meta}</p>
                  <h1 class="h-display title">{title}</h1>
                </div>
              </div>
            ) : (
              <>
                <p class="label meta">{meta}</p>
                <h1 class="h-display title">{title}</h1>
              </>
            )}
          </>
        )
      }
      <p class="summary">{summary}</p>
      {role && <p class="label role">{role}</p>}
    </header>

    {
      stats.length > 0 && (
        <div class="container stats-wrap">
          <dl class="stats">
            {stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    {
      cover && (
        <div class="container">
          <div class:list={['cover', `cover-${coverFit}`]}>
            <Image src={cover} alt={coverAlt} widths={[640, 1200, 2000]} sizes="(max-width: 1360px) 100vw, 1360px" loading="eager" />
          </div>
        </div>
      )
    }

    <div class="container body">
      <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      gallery.length > 0 && <Gallery items={gallery} />
    }

    {
      documents.length > 0 && <Documents items={documents} />
    }

    {
      related.length > 0 && (
        <section class="container related">
          <h2 class="h-display h-section">Related writing</h2>
          <div class="rgrid">{related.map((p) => <PostCard post={p} />)}</div>
        </section>
      )
    }

    {
      next && (
        <nav class="container next" aria-label="Next">
          <a href={next.href}>
            <span class="label">{next.label ?? 'Next'}</span>
            <span class="next-title">{next.title} <span class="arr" aria-hidden="true">↗</span></span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: 36px;
  }
  .back {
    margin-bottom: clamp(32px, 6vw, 64px);
  }
  .back span {
    color: var(--accent-ink);
  }
  .meta {
    margin: 0 0 14px;
  }
  /* Product shots on white (heroStrip): same 16:7 banner as the photo titles (SOAR,
     AstroPulse), products filling it, and the title laid over the bottom-left in black on a
     white fade (the light version of the photo titles' dark fade). White in both themes. */
  .spt {
    position: relative;
    margin-bottom: 28px;
  }
  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    align-items: start;
    gap: clamp(8px, 2vw, 32px);
    aspect-ratio: 16 / 7;
    padding: clamp(16px, 2.2vw, 32px) clamp(20px, 3vw, 48px);
    background: var(--panel-white);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
  }
  .strip :global(img) {
    display: block;
    width: 100%;
    height: 66%;
    object-fit: contain;
    object-position: 50% 0;
  }
  /* The first product sits above the title, so it stays in the top half. */
  .strip :global(img:first-child) {
    height: 52%;
  }
  .strip::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 70% at 0% 100%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 70%),
      linear-gradient(
        to top,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.85) 20%,
        rgba(255, 255, 255, 0.5) 36%,
        rgba(255, 255, 255, 0.12) 48%,
        rgba(255, 255, 255, 0) 58%
      );
  }
  .spt-text {
    position: absolute;
    left: clamp(24px, 3vw, 48px);
    right: clamp(24px, 3vw, 48px);
    bottom: clamp(24px, 3vw, 44px);
  }
  .spt .meta {
    margin: 0 0 12px;
    color: var(--panel-white-muted);
  }
  .spt .title {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 96px);
    max-width: 14ch;
    color: var(--panel-white-fg);
  }
  /* Phone: products only in the panel, then the text below in normal colours. */
  @media (max-width: 760px) {
    .strip {
      padding: 20px 12px;
    }
    .strip::after {
      display: none;
    }
    .strip {
      aspect-ratio: auto;
      align-items: center;
    }
    .strip :global(img),
    .strip :global(img:first-child) {
      height: auto;
      max-height: 160px;
      object-position: 50% 50%;
    }
    .spt-text {
      position: static;
      margin-top: clamp(28px, 6vw, 40px);
    }
    .spt .meta {
      color: var(--muted);
    }
    .spt .title {
      color: var(--fg);
    }
  }
  .title {
    margin: 0 0 18px;
    font-size: clamp(40px, 6.4vw, 92px);
    max-width: 16ch;
  }
  .head :global(.pt) {
    margin-bottom: 28px;
  }
  .summary {
    margin: 0 0 18px;
    max-width: var(--intro-w);
    text-wrap: pretty;
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--fg-2);
    line-height: 1.5;
  }
  .role {
    margin: 0;
    color: var(--fg-2);
  }

  /* Each stat takes the width its text needs; the spare space is shared out evenly. */
  .stats {
    display: flex;
    margin: 0 0 36px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats div {
    flex: 1 1 auto;
    padding: 18px 20px 18px 0;
  }
  .stats div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .stats dt {
    margin-bottom: 6px;
  }
  /* A step above body text, in lime. */
  .stats dd {
    margin: 0;
    font-size: clamp(19px, 1.6vw, 23px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--accent-ink);
  }
  @media (max-width: 700px) {
    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats div + div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  .cover {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: radial-gradient(ellipse at 50% 60%, var(--media-glow), transparent 70%), var(--surface);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: cover;
  }
  .cover-contain :global(img) {
    object-fit: contain;
    height: min(70vh, 720px);
    padding: 24px;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    padding-block: clamp(48px, 7vw, 96px);
  }
  /* Straight after the stats bar (no cover image): keep the text close to it. */
  .stats-wrap + .body {
    padding-top: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: flex-start;
    position: sticky;
    top: var(--sticky-top);
    align-self: start;
  }
  .body .prose > :global(:first-child) {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .tags {
      position: static;
    }
  }

  .related {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .rgrid {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }

  .next {
    border-top: 1px solid var(--line);
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: clamp(40px, 6vw, 80px);
    text-decoration: none;
  }
  .next-title {
    font-size: clamp(30px, 4.6vw, 64px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .arr {
    color: var(--accent-ink);
  }
  .next a:hover .next-title {
    color: var(--accent-ink);
  }
</style>
