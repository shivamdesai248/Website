---
/**
 * Photo with the page title laid over it (see docs/DESIGN.md §5 "Photo title").
 * Desktop (> 760px): label + h1 sit bottom-left on a dark fade over the photo.
 * Phone: the text drops below the photo in the normal page colours.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** CSS object-position for the crop, e.g. "50% 35%". */
  position?: string;
  label: string;
  title: string;
}
const { image, alt, position = '50% 50%', label, title } = Astro.props;
---
<div class="pt">
  <div class="pt-media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 1200, 1800, 2400]}
      sizes="(max-width: 1360px) 100vw, 1360px"
      loading="eager"
      fetchpriority="high"
      style={`object-position:${position}`}
    />
  </div>
  <div class="pt-text">
    <p class="label pt-label">{label}</p>
    <h1 class="h-display pt-title">{title}</h1>
  </div>
</div>
<style>
  .pt {
    position: relative;
  }
  .pt-media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 7;
    background: var(--surface);
  }
  .pt-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pt-label {
    margin: 0 0 12px;
  }
  .pt-title {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 96px);
    max-width: 14ch;
  }

  /* Desktop: text over the photo on a dark fade (same in light and dark mode). */
  @media (min-width: 761px) {
    .pt-media::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        to top,
        rgba(var(--overlay-rgb), 0.85) 0%,
        rgba(var(--overlay-rgb), 0.6) 16%,
        rgba(var(--overlay-rgb), 0.3) 32%,
        rgba(var(--overlay-rgb), 0.08) 46%,
        rgba(var(--overlay-rgb), 0) 56%
      );
    }
    .pt-text {
      position: absolute;
      left: clamp(24px, 3vw, 48px);
      right: clamp(24px, 3vw, 48px);
      bottom: clamp(24px, 3vw, 44px);
    }
    .pt-label {
      color: var(--on-photo-muted);
    }
    .pt-title {
      color: var(--on-photo);
    }
  }

  /* Phone: photo, then the text below in normal colours. */
  @media (max-width: 760px) {
    .pt-media {
      aspect-ratio: 4 / 3;
    }
    .pt-text {
      margin-top: clamp(28px, 6vw, 40px);
    }
  }
</style>
