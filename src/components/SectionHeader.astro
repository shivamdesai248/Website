---
/** Section heading (a plain title like "Experience"), optional intro paragraph below, optional link on the right. */
interface Props {
  title: string;
  linkHref?: string;
  linkText?: string;
  /** Short paragraph(s) under the title telling visitors what the section is about. */
  intro?: string | string[];
}
const { title, linkHref, linkText, intro } = Astro.props;
const paras = intro === undefined ? [] : Array.isArray(intro) ? intro : [intro];
---
<header class="sh">
  <div>
    <h2 class="h-display sh-title">{title}</h2>
    {paras.map((p) => <p class="sh-intro">{p}</p>)}
  </div>
  {linkHref && <a class="link-arrow" href={linkHref}>{linkText}<span aria-hidden="true">↗</span></a>}
</header>
<style>
  .sh {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(28px, 4vw, 48px);
    flex-wrap: wrap;
  }
  .sh-title {
    margin: 0;
    font-size: clamp(32px, 4.4vw, 56px);
    max-width: 18ch;
  }
  /* Same size, line height and colour as the About text; wider, since no photo sits beside it. */
  .sh-intro {
    margin: 14px 0 0;
    max-width: var(--intro-w);
    text-wrap: pretty; /* avoids a single word alone on the last line */
    font-size: clamp(17px, 1.25vw, 19px);
    line-height: 1.6;
  }
  .sh-title + .sh-intro {
    margin-top: 18px;
  }
</style>
