---
/**
 * Masonry photo gallery with a lightbox (see docs/DESIGN.md §5 "Gallery").
 * - Photos keep their own shape and fill their box; columns flow and reflow by width.
 * - Click a photo to open it large over a blurred page. Esc / click outside closes;
 *   ← → (or the buttons) move between photos.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { image: ImageMetadata; alt: string; caption?: string }[];
  title?: string;
}
const { items, title = 'Gallery' } = Astro.props;
const full = await Promise.all(
  items.map((g) => getImage({ src: g.image, width: Math.min(2200, g.image.width), format: 'webp' })),
);
---
<section class="container gallery-wrap" aria-labelledby="gallery-title">
  <h2 id="gallery-title" class="h-display gallery-title">{title}</h2>
  <div class="masonry">
    {
      items.map((g, i) => (
        <figure class="tile">
          <button
            type="button"
            class="tile-btn"
            data-full={full[i].src}
            data-caption={g.caption ?? ''}
            data-alt={g.alt}
            aria-label={`View larger: ${g.alt}`}
          >
            <Image src={g.image} alt={g.alt} widths={[480, 800, 1200]} sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw" />
          </button>
          {g.caption && <figcaption>{g.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</section>

<div class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button type="button" class="lb-btn lb-close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    <figcaption class="lb-caption"></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-next" aria-label="Next photo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</div>

<script>
  const box = document.querySelector<HTMLElement>('.lightbox');
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile-btn')];
  if (box && tiles.length) {
    const img = box.querySelector<HTMLImageElement>('.lb-img')!;
    const cap = box.querySelector<HTMLElement>('.lb-caption')!;
    let index = 0;
    let lastFocus: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length;
      const t = tiles[index];
      img.src = t.dataset.full!;
      img.alt = t.dataset.alt ?? '';
      cap.textContent = t.dataset.caption ?? '';
      cap.hidden = !t.dataset.caption;
    };
    const open = (i: number) => {
      lastFocus = document.activeElement as HTMLElement;
      show(i);
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => box.classList.add('lb-open'));
      box.querySelector<HTMLButtonElement>('.lb-close')!.focus();
    };
    const close = () => {
      box.classList.remove('lb-open');
      document.body.style.overflow = '';
      setTimeout(() => (box.hidden = true), 200);
      lastFocus?.focus();
    };

    tiles.forEach((t, i) => t.addEventListener('click', () => open(i)));
    box.querySelector('.lb-close')!.addEventListener('click', close);
    box.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
    box.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
    box.addEventListener('click', (e) => {
      if (e.target === box) close();
    });
    if (tiles.length < 2) box.querySelectorAll<HTMLElement>('.lb-prev, .lb-next').forEach((b) => (b.hidden = true));
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>

<style>
  .gallery-wrap {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .gallery-title {
    margin: 0 0 clamp(20px, 3vw, 32px);
    font-size: clamp(28px, 3vw, 40px);
  }

  /* Masonry: CSS columns, so each photo keeps its own height and the layout flows. */
  .masonry {
    columns: 3 260px;
    column-gap: 16px;
  }
  .tile {
    break-inside: avoid;
    margin: 0 0 16px;
  }
  .tile-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
  }
  .tile-btn :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }
  .tile-btn:hover :global(img) {
    transform: scale(1.03);
  }
  .tile figcaption {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: clamp(16px, 4vw, 56px);
    background: rgba(var(--overlay-rgb), 0.55);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.lb-open {
    opacity: 1;
  }
  .lb-figure {
    margin: 0;
    max-width: min(1400px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100vh - 160px);
    width: auto;
    height: auto;
    border-radius: 14px;
    background: var(--surface);
  }
  .lb-caption {
    margin-top: 12px;
    font-size: 15px;
    color: var(--on-photo-muted);
    text-align: center;
  }
  .lb-btn {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(var(--overlay-rgb), 0.2);
    background: var(--surface);
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lb-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .lb-btn svg {
    width: 18px;
    height: 18px;
  }
  .lb-close {
    position: absolute;
    top: clamp(16px, 3vw, 28px);
    right: clamp(16px, 3vw, 28px);
  }
  @media (max-width: 600px) {
    .lb-prev,
    .lb-next {
      position: absolute;
      bottom: 20px;
    }
    .lb-prev {
      left: calc(50% - 54px);
    }
    .lb-next {
      right: calc(50% - 54px);
    }
    .lb-img {
      max-height: calc(100vh - 200px);
    }
  }
</style>
