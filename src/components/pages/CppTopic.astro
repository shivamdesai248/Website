---
/** /cpp/<topic> — one Embedded C++ topic page. */
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleBody from '../ArticleBody.astro';
import Documents from '../Documents.astro';
import { formatDate, readingTime } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  topic: CollectionEntry<'cpp'>;
  index: number;
  total: number;
  prev?: CollectionEntry<'cpp'>;
  next?: CollectionEntry<'cpp'>;
}
const { topic, index, total, prev, next } = Astro.props;
const d = topic.data;
const { Content, headings } = await render(topic);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${d.title} · Embedded C++`} description={d.description} image={d.cover?.src}>
  <article>
    <header class="container head">
      <a href={url('/cpp')} class="link-arrow back"><span aria-hidden="true">←</span> Embedded C++</a>
      <p class="label meta">
        Topic {pad(index + 1)} of {pad(total)} · {readingTime(topic.body)}
        {d.updated && <> · Updated {formatDate(d.updated)}</>}
        {d.draft && <> · Draft</>}
      </p>
      <h1 class="h-display title">{d.title}</h1>
      <p class="desc">{d.description}</p>
      {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </header>

    {
      d.cover && (
        <div class="container">
          <div class="cover">
            <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1200, 2000]} sizes="(max-width: 1360px) 100vw, 1360px" loading="eager" />
          </div>
        </div>
      )
    }

    <ArticleBody headings={headings}>
      <Content />
    </ArticleBody>

    {d.documents.length > 0 && <Documents items={d.documents} />}

    <nav class="container pager" aria-label="More topics">
      {
        prev ? (
          <a href={url(`/cpp/${prev.id}`)}>
            <span class="label">← Previous</span>
            <span class="p-title">{prev.data.title}</span>
          </a>
        ) : (
          <a href={url('/cpp')}>
            <span class="label">← Overview</span>
            <span class="p-title">Embedded C++</span>
          </a>
        )
      }
      {
        next ? (
          <a class="right" href={url(`/cpp/${next.id}`)}>
            <span class="label">Next →</span>
            <span class="p-title">{next.data.title}</span>
          </a>
        ) : (
          <a class="right" href={url('/cpp#topics')}>
            <span class="label">All topics →</span>
            <span class="p-title">Embedded C++</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: 8px;
    max-width: 1100px;
  }
  .back {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .back span {
    color: var(--accent-ink);
  }
  .meta {
    margin: 0 0 14px;
  }
  .title {
    margin: 0 0 18px;
    font-size: clamp(36px, 5.4vw, 76px);
    max-width: 20ch;
  }
  .desc {
    margin: 0 0 20px;
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--fg-2);
    max-width: 680px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cover {
    margin-top: 28px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-block: 40px 72px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }
  .pager .right {
    text-align: right;
  }
  .p-title {
    font-size: 20px;
    font-weight: 500;
  }
  .pager a:hover .p-title {
    color: var(--accent-ink);
  }
</style>
