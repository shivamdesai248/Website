---
import Documents from '../Documents.astro';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post, newer, older } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={d.title} description={d.description} image={d.cover?.src}>
  <article>
    <header class="container head">
      <a href={url('/blog')} class="link-arrow back"><span aria-hidden="true">←</span> All posts</a>
      <p class="label meta">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {readingTime(post.body)}
        {d.updated && <> · Updated {formatDate(d.updated)}</>}
        {d.draft && <> · Draft</>}
      </p>
      <h1 class="h-display title">{d.title}</h1>
      <p class="desc">{d.description}</p>
      {
        (d.tags.length > 0 || d.experience) && (
          <div class="tags">
            {d.experience && <a class="tag tag-link" href={url(`/experience/${d.experience}`)}>{d.experience === 'astropulse' ? 'AstroPulse' : d.experience === 'soar' ? 'SOAR' : 'Garmin'} ↗</a>}
            {d.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )
      }
    </header>

    {
      d.cover && (
        <div class="container">
          <div class="cover">
            <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1200, 2000]} sizes="(max-width: 1360px) 100vw, 1360px" loading="eager" />
          </div>
        </div>
      )
    }

    <div class="container body">
      <aside class="toc" aria-label="On this page">
        {
          toc.length > 1 && (
            <>
              <p class="label">On this page</p>
              <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </>
          )
        }
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    {d.documents.length > 0 && <Documents items={d.documents} />}

    {
      (newer || older) && (
        <nav class="container pager" aria-label="More posts">
          {older ? <a href={url(`/blog/${older.id}`)}><span class="label">← Older</span><span class="p-title">{older.data.title}</span></a> : <span />}
          {newer && <a class="right" href={url(`/blog/${newer.id}`)}><span class="label">Newer →</span><span class="p-title">{newer.data.title}</span></a>}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: 36px;
    max-width: 1100px;
  }
  .back {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .back span {
    color: var(--accent-ink);
  }
  .meta {
    margin: 0 0 14px;
  }
  .title {
    margin: 0 0 18px;
    font-size: clamp(36px, 5.4vw, 76px);
    max-width: 20ch;
  }
  .desc {
    margin: 0 0 20px;
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--fg-2);
    max-width: 680px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag-link {
    text-decoration: none;
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }
  .cover {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(180px, 260px) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 80px);
    padding-block: clamp(40px, 6vw, 80px);
  }
  .toc {
    position: sticky;
    top: var(--sticky-top);
    align-self: start;
  }
  .toc ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc li a {
    display: block;
    padding: 6px 0 6px 14px;
    color: var(--muted);
    text-decoration: none;
    font-size: 14.5px;
  }
  .toc li a:hover {
    color: var(--fg);
  }
  .body .prose > :global(:first-child) {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-block: 40px 72px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }
  .pager .right {
    text-align: right;
  }
  .p-title {
    font-size: 20px;
    font-weight: 500;
  }
  .pager a:hover .p-title {
    color: var(--accent-ink);
  }
</style>
