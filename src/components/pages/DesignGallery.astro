---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getDesignItems } from '../../lib/content';
import { url } from '../../lib/url';
import { designIntro, designAbout } from '../../data/intros';
import { inspiration } from '../../data/inspiration';

const items = await getDesignItems();
/** "LinkedIn" for LinkedIn profiles, otherwise the site's domain (e.g. "cadenkraft.com"). */
const linkLabel = (href: string) => {
  const host = new URL(href).hostname.replace(/^www\./, '');
  return host === 'linkedin.com' ? 'LinkedIn' : host;
};
---
<Base title="Design" description="Renders, posters and presentations by Shivam Desai.">
  <section class="container head">
    <h1 class="h-display title">Design</h1>
    <p class="intro">{designIntro}</p>
    <div class="prose about-design">
      {designAbout.map((para) => <p>{para}</p>)}
    </div>

  </section>
  <section class="container works" data-masonry aria-label="Design work">
    {
      items.map((d) => (
        <figure class="item">
          {/* Frame opens: the file in `href` (e.g. a PDF), else the write-up for a clip, else the full-size image. */}
          <a
            class:list={['frame', `fit-${d.data.fit}`, { 'has-aspect': d.data.aspect }]}
            style={d.data.aspect ? `--aspect: ${d.data.aspect}` : undefined}
            href={d.data.href ? url(d.data.href) : d.data.video && d.data.post ? url(`/blog/${d.data.post}`) : d.data.image.src}
            {...(d.data.video && d.data.post && !d.data.href ? {} : { target: '_blank', rel: 'noopener' })}
          >
            {d.data.video ? (
              <video src={url(d.data.video)} poster={d.data.image.src} width={d.data.image.width} height={d.data.image.height} data-loop autoplay muted loop playsinline preload="metadata" aria-label={d.data.alt} />
            ) : (
              <Image src={d.data.image} alt={d.data.alt} widths={[640, 1200, 1800]} sizes="(max-width: 760px) 100vw, 33vw" />
            )}
          </a>
          <figcaption>
            <span class="label">{d.data.kind}{d.data.tools.length > 0 && ` · ${d.data.tools.join(', ')}`}</span>
            <span class="name">{d.data.title}</span>
            <span class="links">
              {d.data.post && <a class="link-arrow" href={url(`/blog/${d.data.post}`)}>Read the write-up<span aria-hidden="true">↗</span></a>}
              {d.data.experience && <a class="link-arrow" href={url(`/experience/${d.data.experience}`)}>Related experience<span aria-hidden="true">↗</span></a>}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </section>

  {
    inspiration.length > 0 && (
      <section class="container insp-wrap" aria-labelledby="inspiration">
        <h2 id="inspiration" class="h-display insp-title">Inspiration</h2>
        <p class="insp-intro">People whose work, and the way they present it, I look up to.</p>
        <ul class="insp">
          {inspiration.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                <span class="label">{linkLabel(p.href)}</span>
                <span class="i-name">
                  {p.name} <span class="arr" aria-hidden="true">↗</span>
                </span>
                {p.note && <span class="i-note">{p.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
<script>
  // Row-first masonry: item 1, 2, 3 run across the top, then each next item drops into the
  // shortest column. Column count matches the CSS fallback (300px min column, 20px gap, max 3).
  const box = document.querySelector<HTMLElement>('[data-masonry]');
  if (box) {
    const items = Array.from(box.querySelectorAll<HTMLElement>(':scope > .item'));
    let current = 0;
    const place = () => {
      const cols = Math.max(1, Math.min(3, Math.floor((box.clientWidth + 20) / (300 + 20))));
      if (cols === current) return;
      current = cols;
      box.querySelectorAll(':scope > .mcol').forEach((c) => c.remove());
      if (cols === 1) {
        box.classList.remove('is-placed');
        items.forEach((it) => box.append(it));
        return;
      }
      box.classList.add('is-placed');
      const columns = Array.from({ length: cols }, () => {
        const c = document.createElement('div');
        c.className = 'mcol';
        box.append(c);
        return c;
      });
      for (const it of items) {
        const shortest = columns.reduce((a, b) => (b.offsetHeight < a.offsetHeight ? b : a));
        shortest.append(it);
      }
    };
    place();
    let t: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(place, 120);
    });
  }
</script>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 72px);
    padding-bottom: 40px;
  }
  .title {
    margin: 0 0 16px;
    font-size: clamp(40px, 6.4vw, 92px);
  }
  .about-design {
    margin-top: 24px;
  }
  .intro {
    margin: 0;
    max-width: 620px;
    color: var(--muted);
    font-size: 19px;
  }
  /* Masonry like the experience-page galleries: CSS columns, each piece keeps its own shape. */
  .works {
    columns: 3 300px;
    column-gap: 20px;
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .item {
    break-inside: avoid;
    margin: 0 0 28px;
  }
  .frame {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .frame :global(img),
  .frame video {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.5s ease;
  }
  /* With JS, items are placed left to right into the shortest column (script below),
     so the page reads in `order`. Without JS, plain CSS columns are the fallback. */
  .works.is-placed {
    columns: auto;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .works :global(.mcol) {
    flex: 1 1 0;
    min-width: 0;
  }
  /* `aspect:` in frontmatter: fixed tile shape; the image fills it or fits inside it. */
  .frame.has-aspect {
    aspect-ratio: var(--aspect);
  }
  .frame.has-aspect :global(img),
  .frame.has-aspect video {
    height: 100%;
    object-fit: cover;
  }
  .frame.has-aspect.fit-contain :global(img) {
    object-fit: contain;
  }
  /* Transparent renders: a little breathing room on the surface colour. */
  .frame.fit-contain :global(img) {
    padding: 20px;
  }
  .frame:hover :global(img),
  .frame:hover video {
    transform: scale(1.02);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 12px;
  }
  .name {
    font-size: 19px;
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  /* Inspiration: link rows in the Documents style. */
  .insp-wrap {
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .insp-title {
    margin: 0 0 12px;
    font-size: clamp(32px, 4.4vw, 56px);
  }
  .insp-intro {
    margin: 0 0 clamp(20px, 3vw, 32px);
    max-width: 680px;
    font-size: clamp(17px, 1.4vw, 19px);
    color: var(--fg-2);
  }
  .insp {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .insp li {
    border-top: 1px solid var(--line);
  }
  .insp a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 18px;
    text-decoration: none;
    color: var(--fg);
  }
  .i-name {
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.2s ease;
  }
  .arr {
    color: var(--accent-ink);
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .i-note {
    color: var(--muted);
    font-size: 15px;
    max-width: 62ch;
  }
  .insp a:hover .i-name,
  .insp a:focus-visible .i-name {
    color: var(--accent-ink);
  }
  .insp a:hover .arr {
    transform: translate(2px, -2px);
  }
</style>
